# Two isolated environments (see README "Environments") and Python junk
.venv/
.venv-mlx/
__pycache__/
*.py[cod]

# Generated audio and sidecars stay local; keep the folder
output/*
!output/.gitkeep

# Secrets
.env
.env.*
!.env.example

# Frontend dependencies. The built UI in web/dist is tracked so the page runs
# without a second install step.
web/node_modules/
web/.claude/
*.tsbuildinfo

# Local editor and tool state. .claude/settings.json (if ever added) stays tracked.
.vscode/
.idea/
.cursor/
*.swp
*.swo
.DS_Store
*.log
.claude/hooks-state/
