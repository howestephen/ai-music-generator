{
  "schema_version": 5,
  "default_backend": "stable-audio-medium",
  "backends": {
    "acestep": {
      "model_id": "ACE-Step/ACE-Step-v1-3.5B",
      "venv": ".venv",
      "runner": null,
      "licence": "Apache-2.0 (commercial OK)",
      "notes": "Song-form model. Weak at orchestral/cinematic: tends toward band instrumentation.",
      "dtype": "float32",
      "prompt_style": "tags",
      "instrumental_tag": "[inst]",
      "supports_lyrics": true,
      "output_audit": {
        "minimum_duration_ratio": 0.98,
        "duration_tolerance_seconds": 0.0,
        "random_seed_retries": 1,
        "duration_contract": "best_effort"
      },
      "runtime": {
        "probe_modules": ["acestep.pipeline_ace_step"],
        "timeout_seconds": null,
        "runner_options": {}
      },
      "controls": {
        "duration": {
          "default": 60,
          "minimum": 1,
          "maximum": 240,
          "step": 1,
          "label": "Target duration (s)",
          "info": "ACE-Step supports 1 to 240 seconds. Delivered audio is measured and checked.",
          "integer": false
        },
        "steps": {
          "default": 60,
          "minimum": 1,
          "maximum": 200,
          "step": 1,
          "label": "Steps",
          "info": "Lower is faster and rougher. ACE-Step defaults to 60.",
          "integer": true
        },
        "guidance": {
          "default": 15,
          "minimum": 0,
          "maximum": 30,
          "step": 0.1,
          "label": "Prompt adherence",
          "info": "ACE-Step guidance scale. Default: 15.",
          "integer": false
        }
      }
    },
    "minimax-mlx": {
      "model_id": "vanch007/MiniMax-Music3-MLX-8bit",
      "venv": ".venv-mlx",
      "runner": "minimax_mlx_runner.py",
      "licence": "MiniMax Community (commercial OK w/ attribution; >$20M revenue needs authorisation)",
      "notes": "Native Apple MLX/Metal, 8-bit. 13GB vs 54GB fp32. Preferred build on Apple Silicon.",
      "dtype": "8-bit (MLX)",
      "prompt_style": "caption",
      "instrumental_tag": "[Instrumental]",
      "supports_lyrics": true,
      "output_audit": {
        "minimum_duration_ratio": 0.9,
        "duration_tolerance_seconds": 0.0,
        "random_seed_retries": 1,
        "duration_contract": "best_effort"
      },
      "runtime": {
        "probe_modules": ["mlx_minimax_music3.cli"],
        "timeout_seconds": 7200,
        "runner_options": {}
      },
      "controls": {
        "duration": {
          "default": 60,
          "minimum": 1,
          "maximum": 300,
          "step": 1,
          "label": "Target duration (s)",
          "info": "MiniMax supports up to 300 seconds. Its stop token is suppressed until the target, then the delivered WAV is measured independently.",
          "integer": false
        },
        "steps": {
          "default": 30,
          "minimum": 1,
          "maximum": null,
          "step": 1,
          "label": "Steps",
          "info": "Lower is faster and rougher. MiniMax defaults to 30.",
          "integer": true
        },
        "guidance": null
      }
    },
    "stable-audio-sm": {
      "model_id": "stabilityai/stable-audio-3-optimized",
      "venv": ".venv-sa3",
      "runner": "stable_audio_runner.py",
      "licence": "Stability AI Community (commercial OK below the revenue threshold; bundled T5Gemma adds the Gemma Terms of Use)",
      "notes": "Fixed-length latent diffusion, 44.1kHz stereo. 50M DiT, roughly 28x realtime on Apple Silicon. Music-specialised, licensed training data.",
      "dtype": "fp16 DiT / fp32 codec (MLX)",
      "prompt_style": "description",
      "instrumental_tag": "",
      "supports_lyrics": false,
      "output_audit": {
        "minimum_duration_ratio": 1,
        "duration_tolerance_seconds": 0.05,
        "random_seed_retries": 0,
        "duration_contract": "exact"
      },
      "runtime": {
        "probe_modules": ["mlx.core", "models.defs.sa3_pipeline", "weights"],
        "timeout_seconds": 3600,
        "runner_options": {"dit": "sm-music", "decoder": "same-s"}
      },
      "controls": {
        "duration": {
          "default": 60,
          "minimum": 1,
          "maximum": 120,
          "step": 1,
          "label": "Target duration (s)",
          "info": "Fixed-length diffusion: the delivered WAV is exactly this long, up to 120 seconds.",
          "integer": false
        },
        "steps": {
          "default": 8,
          "minimum": 1,
          "maximum": 50,
          "step": 1,
          "label": "Steps",
          "info": "Pingpong sampler steps. 1 is a single forward pass; 8 is the vendor's sweet spot.",
          "integer": true
        },
        "guidance": {
          "default": 1,
          "minimum": 0,
          "maximum": 10,
          "step": 0.1,
          "label": "Prompt adherence",
          "info": "Classifier-free guidance. 1 is off; above 1 pushes toward the prompt.",
          "integer": false
        }
      }
    },
    "stable-audio-medium": {
      "model_id": "stabilityai/stable-audio-3-optimized",
      "venv": ".venv-sa3",
      "runner": "stable_audio_runner.py",
      "licence": "Stability AI Community (commercial OK below the revenue threshold; bundled T5Gemma adds the Gemma Terms of Use)",
      "notes": "Fixed-length latent diffusion, 44.1kHz stereo. 1.4B DiT, higher musicality and slower. Music-specialised, licensed training data.",
      "dtype": "fp16 DiT / fp32 codec (MLX)",
      "prompt_style": "description",
      "instrumental_tag": "",
      "supports_lyrics": false,
      "output_audit": {
        "minimum_duration_ratio": 1,
        "duration_tolerance_seconds": 0.05,
        "random_seed_retries": 0,
        "duration_contract": "exact"
      },
      "runtime": {
        "probe_modules": ["mlx.core", "models.defs.sa3_pipeline", "weights"],
        "timeout_seconds": 7200,
        "runner_options": {"dit": "medium", "decoder": "same-l"}
      },
      "controls": {
        "duration": {
          "default": 60,
          "minimum": 1,
          "maximum": 380,
          "step": 1,
          "label": "Target duration (s)",
          "info": "Fixed-length diffusion: the delivered WAV is exactly this long, up to 380 seconds.",
          "integer": false
        },
        "steps": {
          "default": 8,
          "minimum": 1,
          "maximum": 50,
          "step": 1,
          "label": "Steps",
          "info": "Pingpong sampler steps. 1 is a single forward pass; 8 is the vendor's sweet spot.",
          "integer": true
        },
        "guidance": {
          "default": 1,
          "minimum": 0,
          "maximum": 10,
          "step": 0.1,
          "label": "Prompt adherence",
          "info": "Classifier-free guidance. 1 is off; above 1 pushes toward the prompt.",
          "integer": false
        }
      }
    },
    "musicgen": {
      "model_id": "facebook/musicgen-stereo-large",
      "venv": ".venv",
      "runner": "musicgen_runner.py",
      "licence": "CC-BY-NC-4.0, NON-COMMERCIAL ONLY",
      "notes": "Strong instrumental model, but 30s per generation.",
      "dtype": "float32",
      "prompt_style": "tags",
      "instrumental_tag": "",
      "supports_lyrics": false,
      "output_audit": {
        "minimum_duration_ratio": 0.98,
        "duration_tolerance_seconds": 0.0,
        "random_seed_retries": 1,
        "duration_contract": "best_effort"
      },
      "runtime": {
        "probe_modules": ["soundfile", "torch", "transformers"],
        "timeout_seconds": 7200,
        "runner_options": {}
      },
      "controls": {
        "duration": {
          "default": 30,
          "minimum": 1,
          "maximum": 30,
          "step": 1,
          "label": "Target duration (s)",
          "info": "MusicGen is architecturally capped at 30 seconds. Delivered audio is measured and checked.",
          "integer": false
        },
        "steps": null,
        "guidance": {
          "default": 3,
          "minimum": 0,
          "maximum": 30,
          "step": 0.1,
          "label": "Prompt adherence",
          "info": "MusicGen guidance scale. Default: 3.",
          "integer": false
        }
      }
    }
  }
}
