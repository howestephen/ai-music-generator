{
  "schema_version": 8,
  "default_backend": "stable-audio-medium",
  "backends": {
    "acestep": {
      "task": "generate",
      "model_id": "ACE-Step/Ace-Step1.5",
      "venv": ".venv-ace",
      "runner": "acestep_runner.py",
      "licence": "MIT (commercial OK)",
      "notes": "1.5 turbo. Seneca's 4090 runs it when ComfyUI answers, otherwise MLX on this Mac. Cover and repaint are not connected.",
      "label": "ACE-Step",
      "version": "1.5",
      "dtype": "MLX",
      "prompt_style": "tags",
      "instrumental_tag": "[Instrumental]",
      "supports_lyrics": true,
      "supports_editing": false,
      "output_audit": {
        "minimum_duration_ratio": 0.98,
        "duration_tolerance_seconds": 0.0,
        "random_seed_retries": 1,
        "duration_contract": "best_effort"
      },
      "runtime": {
        "probe_modules": ["acestep.inference"],
        "timeout_seconds": 7200,
        "runner_options": {
          "dit": "acestep-v15-turbo",
          "lm": "acestep-5Hz-lm-0.6B",
          "shift": "3.0"
        }
      },
      "controls": {
        "duration": {
          "default": 120,
          "minimum": 10,
          "maximum": 600,
          "step": 1,
          "label": "Target duration (s)",
          "info": "ACE-Step 1.5 supports 10 to 600 seconds. Delivered audio is measured and checked.",
          "integer": false
        },
        "steps": {
          "default": 8,
          "minimum": 1,
          "maximum": 20,
          "step": 1,
          "label": "Steps",
          "info": "Turbo is distilled to 8 steps. 1 to 20.",
          "integer": true
        },
        "guidance": null
      }
    },
    "minimax-mlx": {
      "task": "generate",
      "model_id": "vanch007/MiniMax-Music3-MLX-8bit",
      "venv": ".venv-mlx",
      "runner": "minimax_mlx_runner.py",
      "licence": "MiniMax Community (commercial OK w/ attribution; >$20M revenue needs authorisation)",
      "notes": "Native Apple MLX/Metal, 8-bit. 13GB vs 54GB fp32. Preferred build on Apple Silicon.",
      "label": "MiniMax Music",
      "version": "3",
      "dtype": "8-bit (MLX)",
      "prompt_style": "caption",
      "instrumental_tag": "[Instrumental]",
      "supports_lyrics": true,
      "supports_editing": false,
      "output_audit": {
        "minimum_duration_ratio": 0.9,
        "duration_tolerance_seconds": 0.0,
        "random_seed_retries": 1,
        "duration_contract": "best_effort"
      },
      "runtime": {
        "probe_modules": ["mlx_minimax_music3.cli"],
        "timeout_seconds": 7200,
        "runner_options": {}
      },
      "controls": {
        "duration": {
          "default": 60,
          "minimum": 1,
          "maximum": 300,
          "step": 1,
          "label": "Target duration (s)",
          "info": "MiniMax supports up to 300 seconds. Its stop token is suppressed until the target, then the delivered WAV is measured independently.",
          "integer": false
        },
        "steps": {
          "default": 30,
          "minimum": 1,
          "maximum": null,
          "step": 1,
          "label": "Steps",
          "info": "Lower is faster and rougher. MiniMax defaults to 30.",
          "integer": true
        },
        "guidance": null
      }
    },
    "stable-audio-sm": {
      "task": "generate",
      "model_id": "stabilityai/stable-audio-3-optimized",
      "venv": ".venv-sa3",
      "runner": "stable_audio_runner.py",
      "licence": "Stability AI Community (commercial OK below the revenue threshold; bundled T5Gemma adds the Gemma Terms of Use)",
      "notes": "Fixed-length latent diffusion, 44.1kHz stereo. 50M DiT, roughly 28x realtime on Apple Silicon. Music-specialised, licensed training data.",
      "label": "Stable Audio (Small)",
      "version": "3",
      "dtype": "fp16 DiT / fp32 codec (MLX)",
      "prompt_style": "description",
      "instrumental_tag": "",
      "supports_lyrics": false,
      "supports_editing": true,
      "output_audit": {
        "minimum_duration_ratio": 1,
        "duration_tolerance_seconds": 0.05,
        "random_seed_retries": 0,
        "duration_contract": "exact"
      },
      "runtime": {
        "probe_modules": ["mlx.core", "models.defs.sa3_pipeline", "weights"],
        "timeout_seconds": 3600,
        "runner_options": {"dit": "sm-music", "decoder": "same-s"}
      },
      "controls": {
        "duration": {
          "default": 120,
          "minimum": 1,
          "maximum": 120,
          "step": 1,
          "label": "Target duration (s)",
          "info": "Fixed-length diffusion: the delivered WAV is exactly this long, up to 120 seconds.",
          "integer": false
        },
        "steps": {
          "default": 8,
          "minimum": 1,
          "maximum": 50,
          "step": 1,
          "label": "Steps",
          "info": "Pingpong sampler steps. 1 is a single forward pass; 8 is the vendor's sweet spot.",
          "integer": true
        },
        "guidance": {
          "default": 1,
          "minimum": 0,
          "maximum": 10,
          "step": 0.1,
          "label": "Prompt adherence",
          "info": "1 follows the prompt and is this model's own default. Above 1 pushes harder toward the prompt. Below 1 pulls away from it.",
          "integer": false
        }
      }
    },
    "stable-audio-medium": {
      "task": "generate",
      "model_id": "stabilityai/stable-audio-3-optimized",
      "venv": ".venv-sa3",
      "runner": "stable_audio_runner.py",
      "licence": "Stability AI Community (commercial OK below the revenue threshold; bundled T5Gemma adds the Gemma Terms of Use)",
      "notes": "Fixed-length latent diffusion, 44.1kHz stereo. 1.4B DiT, higher musicality and slower. Music-specialised, licensed training data.",
      "label": "Stable Audio (Med)",
      "version": "3",
      "dtype": "fp16 DiT / fp32 codec (MLX)",
      "prompt_style": "description",
      "instrumental_tag": "",
      "supports_lyrics": false,
      "supports_editing": true,
      "output_audit": {
        "minimum_duration_ratio": 1,
        "duration_tolerance_seconds": 0.05,
        "random_seed_retries": 0,
        "duration_contract": "exact"
      },
      "runtime": {
        "probe_modules": ["mlx.core", "models.defs.sa3_pipeline", "weights"],
        "timeout_seconds": 7200,
        "runner_options": {"dit": "medium", "decoder": "same-l"}
      },
      "controls": {
        "duration": {
          "default": 180,
          "minimum": 1,
          "maximum": 380,
          "step": 1,
          "label": "Target duration (s)",
          "info": "Fixed-length diffusion: the delivered WAV is exactly this long, up to 380 seconds.",
          "integer": false
        },
        "steps": {
          "default": 8,
          "minimum": 1,
          "maximum": 50,
          "step": 1,
          "label": "Steps",
          "info": "Pingpong sampler steps. 1 is a single forward pass; 8 is the vendor's sweet spot.",
          "integer": true
        },
        "guidance": {
          "default": 1,
          "minimum": 0,
          "maximum": 10,
          "step": 0.1,
          "label": "Prompt adherence",
          "info": "1 follows the prompt and is this model's own default. Above 1 pushes harder toward the prompt. Below 1 pulls away from it.",
          "integer": false
        }
      }
    },
    "musicgen": {
      "task": "generate",
      "model_id": "facebook/musicgen-stereo-large",
      "venv": ".venv",
      "runner": "musicgen_runner.py",
      "licence": "CC-BY-NC-4.0, NON-COMMERCIAL ONLY",
      "notes": "Strong instrumental model, but 30s per generation.",
      "label": "MusicGen (Large)",
      "version": "stereo-large",
      "dtype": "float32",
      "prompt_style": "tags",
      "instrumental_tag": "",
      "supports_lyrics": false,
      "supports_editing": false,
      "output_audit": {
        "minimum_duration_ratio": 0.98,
        "duration_tolerance_seconds": 0.0,
        "random_seed_retries": 1,
        "duration_contract": "best_effort"
      },
      "runtime": {
        "probe_modules": ["soundfile", "torch", "transformers"],
        "timeout_seconds": 7200,
        "runner_options": {}
      },
      "controls": {
        "duration": {
          "default": 30,
          "minimum": 1,
          "maximum": 30,
          "step": 1,
          "label": "Target duration (s)",
          "info": "MusicGen is architecturally capped at 30 seconds. Delivered audio is measured and checked.",
          "integer": false
        },
        "steps": null,
        "guidance": {
          "default": 3,
          "minimum": 0,
          "maximum": 30,
          "step": 0.1,
          "label": "Prompt adherence",
          "info": "MusicGen guidance scale. Default: 3.",
          "integer": false
        }
      }
    },
    "demucs": {
      "task": "separate",
      "model_id": "mlx-community/demucs-mlx",
      "venv": ".venv-demucs",
      "runner": "demucs_runner.py",
      "licence": "MIT (commercial OK)",
      "notes": "HTDemucs on MLX. Splits a mix into vocals, drums, bass and other. A quiet stem is kept.",
      "label": "HTDemucs",
      "version": "4",
      "dtype": "MLX",
      "prompt_style": "tags",
      "instrumental_tag": "",
      "supports_lyrics": false,
      "supports_editing": false,
      "output_audit": {
        "minimum_duration_ratio": 0.98,
        "duration_tolerance_seconds": 0.0,
        "random_seed_retries": 0,
        "duration_contract": "best_effort"
      },
      "runtime": {
        "probe_modules": ["demucs_mlx"],
        "timeout_seconds": 7200,
        "runner_options": {
          "model": "htdemucs"
        }
      },
      "controls": {
        "duration": {
          "default": 120,
          "minimum": 1,
          "maximum": 600,
          "step": 1,
          "label": "Source duration (s)",
          "info": "The mix must be 1 to 600 seconds. Each stem is measured against that length.",
          "integer": false
        },
        "steps": null,
        "guidance": null
      }
    },
    "soulx": {
      "task": "sing",
      "model_id": "mlx-community/SoulX-Singer",
      "venv": ".venv-soulx",
      "runner": "soulx_runner.py",
      "licence": "Apache-2.0 (commercial OK)",
      "notes": "Sings English words on a written melody, in the example voice. One pitched note per word. Score control, MLX weights on the PyTorch module.",
      "label": "SoulX-Singer",
      "version": "2026.02",
      "dtype": "MLX",
      "prompt_style": "tags",
      "instrumental_tag": "",
      "supports_lyrics": true,
      "supports_editing": false,
      "output_audit": {
        "minimum_duration_ratio": 0.98,
        "duration_tolerance_seconds": 0.0,
        "random_seed_retries": 0,
        "duration_contract": "best_effort"
      },
      "runtime": {
        "probe_modules": ["soulxsinger.models.soulxsinger"],
        "timeout_seconds": 7200,
        "runner_options": {}
      },
      "controls": {
        "duration": {
          "default": 120,
          "minimum": 0.2,
          "maximum": 600,
          "step": 0.1,
          "label": "Melody length (s)",
          "info": "The written melody must last 0.2 to 600 seconds.",
          "integer": false
        },
        "steps": null,
        "guidance": null
      }
    },
    "soulx-svc": {
      "task": "sing",
      "model_id": "mlx-community/SoulX-Singer",
      "venv": ".venv-soulx",
      "runner": "soulx_svc_runner.py",
      "licence": "Apache-2.0 (commercial OK)",
      "notes": "Converts a sung recording into the example voice, or a voice you upload. The melody and the words come from the recording. MLX svc weights on the PyTorch module. Pitch is the official RMVPE file, downloaded on first use.",
      "label": "SoulX-Singer SVC",
      "version": "2026.03",
      "dtype": "MLX",
      "prompt_style": "tags",
      "instrumental_tag": "",
      "supports_lyrics": false,
      "supports_editing": false,
      "output_audit": {
        "minimum_duration_ratio": 0.98,
        "duration_tolerance_seconds": 0.0,
        "random_seed_retries": 0,
        "duration_contract": "best_effort"
      },
      "runtime": {
        "probe_modules": ["soulxsinger.models.soulxsinger_svc"],
        "timeout_seconds": 7200,
        "runner_options": {
          "component": "svc"
        }
      },
      "controls": {
        "duration": {
          "default": 120,
          "minimum": 0.2,
          "maximum": 600,
          "step": 0.1,
          "label": "Recording length (s)",
          "info": "The sung recording must last 0.2 to 600 seconds.",
          "integer": false
        },
        "steps": null,
        "guidance": null
      }
    }
  }
}
