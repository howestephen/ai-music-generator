# House editor defaults. Stops formatting churn between the MacBook and seneca.
# Copied into a project, or symlinked from ai-standards.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.md]
# Markdown uses trailing double-space for hard breaks
trim_trailing_whitespace = false
max_line_length = 80

[Makefile]
indent_style = tab

[*.{sh,bash}]
indent_size = 2

[*.{json,yml,yaml,toml}]
indent_size = 2
